[Container]
ContainerName=bichon
Image=docker.io/rustmailer/bichon:latest
Label=io.containers.autoupdate=registry
Memory=512M
PidsLimit=256
PodmanArgs=--cpus=1

Environment=BICHON_ROOT_DIR=/data
Environment=BICHON_LOG_LEVEL=info
Secret=bichon_encrypt_password,type=env,target=BICHON_ENCRYPT_PASSWORD

User=1000
Group=1000
UserNS=keep-id:uid=1000,gid=1000
ReadOnly=true
NoNewPrivileges=true

Volume=/mnt/fast/bichon/data:/data:Z

Network=proxy.network

HealthCmd=curl -fsS http://127.0.0.1:15630/api/status >/dev/null || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
