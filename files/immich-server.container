[Unit]
Description=Immich Server Container
Requires=immich-postgres.service
Requires=immich-valkey.service
Requires=immich-machine-learning.service
After=immich-postgres.service immich-valkey.service immich-machine-learning.service

[Container]
Pod=immich.pod
ContainerName=immich-server
Image=ghcr.io/immich-app/immich-server:v3.1.0@sha256:b434cb9287eea1471c9974845914d4dd328c9c2d652e446ed4930f99944f0ceb
Memory=4G
PidsLimit=512
PodmanArgs=--cpus=4

User=1000
Group=1000
GroupAdd=keep-groups
NoNewPrivileges=true
DropCapability=CAP_NET_RAW

Environment=DB_HOSTNAME=127.0.0.1
Environment=DB_PORT=5432
Environment=DB_USERNAME=immich
Environment=DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=127.0.0.1
Environment=REDIS_PORT=6379
Environment=IMMICH_MACHINE_LEARNING_URL=http://127.0.0.1:3003
Secret=immich_db_password,type=env,target=DB_PASSWORD

Volume=immich-library.volume:/data:Z,U

Timezone=local
AddDevice=/dev/dri:/dev/dri

HealthCmd=curl -fsS http://127.0.0.1:2283/api/server/ping >/dev/null || exit 1

[Service]
Restart=always
