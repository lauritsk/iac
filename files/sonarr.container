[Container]
ContainerName=sonarr
Image=lscr.io/linuxserver/sonarr:latest
Label=io.containers.autoupdate=registry
Memory=1G
PidsLimit=256
PodmanArgs=--cpus=2

Environment=TZ=Europe/Tallinn

User=1000
Group=1000
UserNS=keep-id:uid=1000,gid=1000
ReadOnly=True
NoNewPrivileges=true

Mount=type=tmpfs,destination=/run,U=true,exec
Volume=/mnt/fast/sonarr/config:/config:Z
Volume=/mnt/slow:/data:z

Network=proxy.network

HealthCmd=curl -fsS http://127.0.0.1:8989/ >/dev/null || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
