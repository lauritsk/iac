[Container]
ContainerName=prowlarr
Image=lscr.io/linuxserver/prowlarr:latest
AutoUpdate=registry
Memory=1G
PidsLimit=256
PodmanArgs=--cpus=1

Environment=TZ=Europe/Tallinn

User=1000
Group=1000
UserNS=keep-id:uid=1000,gid=1000
ReadOnly=True
NoNewPrivileges=true

Mount=type=tmpfs,destination=/run,U=true,exec
Volume=/mnt/fast/prowlarr/config:/config:Z

Network=proxy.network

HealthCmd=curl -fsS http://127.0.0.1:9696/ >/dev/null || exit 1

[Service]
Restart=always

[Install]
WantedBy=default.target
