{
	"grants": [
		// Allow all connections
		{
			"src": ["*"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Enable Taildrive
		{
			"src": ["*"],
			"dst": ["*"],
			"ip":  ["*"],

			"app": {
				"tailscale.com/cap/drive": [
					{
						"access": "rw",
						"shares": ["*"],
					},
				],
			},
		},
		// Enable tsidp
		{
			"src": ["autogroup:admin"],
			"dst": ["tag:tsidp"],

			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui": true,
						"allow_dcr":      true,
					},
				],
			},
		},
	],

	"ssh": [
		// Allow connections to own devices
		{
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
			"action": "accept",
		},
		// Allow connections to servers
		{
			"src":    ["karl@laurits.dev"],
			"dst":    ["tag:server", "tag:dev"],
			"users":  ["autogroup:nonroot", "root"],
			"action": "accept",
		},
	],

	"tagOwners": {
		"tag:server":    ["autogroup:admin"],
		"tag:container": ["autogroup:admin"],
		"tag:app":       ["autogroup:admin"],
		"tag:tsidp":     ["autogroup:admin"],
		"tag:dev":       ["autogroup:admin"],
	},

	"nodeAttrs": [
		// Allow members to use Taildrive
		{
			"target": ["autogroup:member"],
			"attr":   ["drive:access", "drive:share"],
		},
		// Allow members and servers to use funnel
		{
			"target": ["autogroup:member", "tag:server"],
			"attr":   ["funnel"],
		},
		{
			"target": ["100.113.246.11"],
			"attr":   ["mullvad"],
		},
		{
			"target": ["100.118.247.55"],
			"attr":   ["mullvad"],
		},
		{
			"target": ["100.98.113.54"],
			"attr":   ["mullvad"],
		},
	],

	"autoApprovers": {
		"services": {
			"tag:app": ["tag:container"],
		},
		"exitNode": ["tag:server"],
	},
}
