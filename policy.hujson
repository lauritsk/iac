{
	"grants": [
		{
			"src": ["tag:ci"],
			"dst": ["tag:server"],
			"ip":  ["tcp:8443"],
		},
		{
			"src": ["autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:member", "tag:server"],
			"dst": ["svc:jellyfin"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["mrria@passkey"],
			"dst": ["svc:immich"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["autogroup:member", "tag:server"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		// Allow connections to own devices
		{
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
			"action": "accept",
		},
		{
			"src":         ["autogroup:member"],
			"dst":         ["autogroup:self"],
			"users":       ["root"],
			"action":      "check",
			"checkPeriod": "12h",
		},
		// Allow connections to servers
		{
			"src":         ["autogroup:admin"],
			"dst":         ["tag:server"],
			"users":       ["autogroup:nonroot", "root"],
			"action":      "check",
			"checkPeriod": "12h",
		},
	],

	"tagOwners": {
		"tag:ci":     ["autogroup:admin"],
		"tag:server": ["autogroup:admin"],
		"tag:app":    ["autogroup:admin"],
	},

	"nodeAttrs": [
		{
			"target": ["autogroup:admin"],
			"attr":   ["funnel"],
		},
	],

	"autoApprovers": {
		"services": {
			"tag:app": ["tag:server"],
		},
		"exitNode": ["tag:server"],
	},

	"tests": [
		{
			"src":    "tag:ci",
			"proto":  "tcp",
			"accept": ["tag:server:8443"],
		},
		{
			"src":    "beccam@passkey",
			"proto":  "tcp",
			"accept": ["svc:jellyfin:443"],
		},
		{
			"src":    "greenmyshelf@gmail.com",
			"proto":  "tcp",
			"accept": ["svc:jellyfin:443"],
		},
		{
			"src":    "juhan@passkey",
			"proto":  "tcp",
			"accept": ["svc:jellyfin:443"],
		},
		{
			"src":    "mrria@passkey",
			"proto":  "tcp",
			"accept": ["svc:jellyfin:443", "svc:immich:443"],
		},
		{
			"src":   "karl@laurits.dev",
			"proto": "tcp",
			"accept": [
				"tag:server:22",
				"tag:server:8443",
				"svc:immich:443",
				"svc:jellyfin:443",
				"svc:prowlarr:443",
				"svc:radarr:443",
				"svc:sonarr:443",
				"svc:transmission:443",
				"svc:zerobyte:443",
			],
		},
	],
}
