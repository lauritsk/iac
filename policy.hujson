{
	"grants": [
		{
			"src": ["autogroup:admin"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		{
			"src": ["autogroup:member", "autogroup:shared", "tag:tv"],
			"dst": ["tag:jellyfin"],
			"ip":  ["tcp:443"],
		},
		{
			"src": ["autogroup:member", "tag:server"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
	],

	"ssh": [
		// Allow connections to own devices
		{
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
			"action": "accept",
		},
		{
			"src":         ["autogroup:member"],
			"dst":         ["autogroup:self"],
			"users":       ["root"],
			"action":      "check",
			"checkPeriod": "12h",
		},
		// Allow connections to servers
		{
			"src":         ["autogroup:admin"],
			"dst":         ["tag:server"],
			"users":       ["autogroup:nonroot", "root"],
			"action":      "check",
			"checkPeriod": "12h",
		},
	],

	"tagOwners": {
		"tag:server":       ["autogroup:admin"],
		"tag:tv":           ["autogroup:admin"],
		"tag:prowlarr":     ["autogroup:admin"],
		"tag:radarr":       ["autogroup:admin"],
		"tag:sonarr":       ["autogroup:admin"],
		"tag:transmission": ["autogroup:admin"],
		"tag:jellyfin":     ["autogroup:admin"],
	},

	"autoApprovers": {
		"exitNode": ["tag:server"],
	},

	"tests": [
		{
			"src":    "tag:tv",
			"proto":  "tcp",
			"accept": ["tag:jellyfin:443"],
		},
		{
			"src":    "beccam@passkey",
			"proto":  "tcp",
			"accept": ["tag:jellyfin:443"],
		},
		{
			"src":    "greenmyshelf@gmail.com",
			"proto":  "tcp",
			"accept": ["tag:jellyfin:443"],
		},
		{
			"src":    "juhan@passkey",
			"proto":  "tcp",
			"accept": ["tag:jellyfin:443"],
		},
		{
			"src":    "mrria@passkey",
			"proto":  "tcp",
			"accept": ["tag:jellyfin:443"],
		},
		{
			"src":   "karl@laurits.dev",
			"proto": "tcp",
			"accept": [
				"tag:server:22",
				"tag:server:8443",
				"tag:prowlarr:443",
				"tag:radarr:443",
				"tag:sonarr:443",
				"tag:transmission:443",
				"tag:jellyfin:443",
			],
		},
	],
}
