variant: flatcar
version: 1.1.0

passwd:
  users:
    - name: core
      groups:
        - video
        - render
      ssh_authorized_keys:
        - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIZnJ+xjVH8DBYOg6HQEa2VN0Np/e7Db13y0pCU/Qqlh karl@laurits.dev

storage:
  files:
    - path: /etc/hostname
      contents:
        inline: |
          hl01
    - path: /etc/subuid
      overwrite: true
      contents:
        inline: |
          core:100000:65536
    - path: /etc/subgid
      overwrite: true
      contents:
        inline: |
          core:100000:65536
    - path: /etc/flatcar/enabled-sysext.conf
      contents:
        inline: |
          podman
          python
    - path: /opt/extensions/tailscale/tailscale-v1.102.2-x86-64.raw
      contents:
        source: https://extensions.flatcar.org/extensions/tailscale-v1.102.2-x86-64.raw
    - path: /etc/sysupdate.tailscale.d/tailscale.conf
      contents:
        source: https://extensions.flatcar.org/extensions/tailscale.conf
    - path: /etc/sysupdate.d/noop.conf
      contents:
        source: https://extensions.flatcar.org/extensions/noop.conf
    - path: /etc/sysctl.d/99-tailscale.conf
      contents:
        inline: |
          net.ipv4.ip_forward = 1
          net.ipv6.conf.all.forwarding = 1
    - path: /var/lib/systemd/linger/core
  links:
    - path: /etc/extensions/docker-flatcar.raw
      target: /dev/null
      overwrite: true
    - path: /etc/extensions/containerd-flatcar.raw
      target: /dev/null
      overwrite: true
    - target: /opt/extensions/tailscale/tailscale-v1.102.2-x86-64.raw
      path: /etc/extensions/tailscale.raw
      hard: false
    - path: /etc/systemd/user/sockets.target.wants/podman.socket
      target: /usr/lib/systemd/user/podman.socket
    - path: /etc/systemd/user/timers.target.wants/podman-auto-update.timer
      target: /usr/lib/systemd/user/podman-auto-update.timer

systemd:
  units:
    - name: tailscaled.service
      enabled: true
    - name: mnt-slow.mount
      enabled: true
      contents: |
        [Unit]
        Description=External HDD filesystem

        [Mount]
        What=incus_slow
        Where=/mnt/slow
        Type=virtiofs

        [Install]
        WantedBy=local-fs.target
    - name: mnt-fast.mount
      enabled: true
      contents: |
        [Unit]
        Description=External SSD filesystem

        [Mount]
        What=incus_fast
        Where=/mnt/fast
        Type=virtiofs

        [Install]
        WantedBy=local-fs.target
    - name: systemd-sysupdate.timer
      enabled: true
    - name: systemd-sysupdate.service
      dropins:
        - name: tailscale.conf
          contents: |
            [Service]
            ExecStartPre=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/tailscale.raw > /tmp/tailscale"
            ExecStartPre=/usr/lib/systemd/systemd-sysupdate -C tailscale update
            ExecStartPost=/usr/bin/sh -c "readlink --canonicalize /etc/extensions/tailscale.raw > /tmp/tailscale-new"
            ExecStartPost=/usr/bin/sh -c "if ! cmp --silent /tmp/tailscale /tmp/tailscale-new; then touch /run/reboot-required; fi"
